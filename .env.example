# FinanceHub Environment Variables Template

# Connection Strings per Microservice (DB Isolation)
ConnectionStrings__AuthConsentDb=Host=localhost;Port=5432;Database=financehub_authconsent;Username=financehub;Password=financehub_password
ConnectionStrings__TransactionAggregatorDb=Host=localhost;Port=5432;Database=financehub_transactionaggregator;Username=financehub;Password=financehub_password

# RabbitMQ Configuration
RabbitMQ__Host=localhost
RabbitMQ__Port=5672
RabbitMQ__Username=guest
RabbitMQ__Password=guest

# Open Finance / Meu.Pluggy Connector
PLUGGY_USER_TOKEN=your_pluggy_user_bearer_token_here
PLUGGY_USER_API_BASE_URL=https://my-api.pluggy.ai
PLUGGY_INTEGRATION_BASE_URL=http://localhost:5056

# API Gateway & Security
JWT_SECRET_KEY=FinanceHubSuperSecretDevKeyWithAtLeast32BytesLength!
JWT_ISSUER=https://financehub.local
JWT_AUDIENCE=financehub-gateway
AUTH_CONSENT_BASE_URL=http://localhost:5001
TRANSACTION_AGGREGATOR_BASE_URL=http://localhost:5002
