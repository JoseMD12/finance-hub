{
  "info": {
    "_postman_id": "a9103c8f-2f88-4a57-b129-37e4c27f6e01",
    "name": "FinanceHub Enterprise API Suite",
    "description": "Coleção oficial completa de testes para todos os microsserviços, BFF ApiGateway, Open Finance Meu.Pluggy e TransactionAggregator (.NET 10). Possui pre-request scripts, auto-captura de JWT token e suíte de testes integrada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request script global da coleção FinanceHub",
          "if (!pm.collectionVariables.get('devUserId')) {",
          "    pm.collectionVariables.set('devUserId', 'usr_dev_001');",
          "}",
          "if (!pm.collectionVariables.get('baseUrl_gateway')) {",
          "    pm.collectionVariables.set('baseUrl_gateway', 'http://localhost:5050');",
          "}",
          "if (!pm.collectionVariables.get('baseUrl_pluggy')) {",
          "    pm.collectionVariables.set('baseUrl_pluggy', 'http://localhost:5056');",
          "}",
          "if (!pm.collectionVariables.get('baseUrl_aggregator')) {",
          "    pm.collectionVariables.set('baseUrl_aggregator', 'http://localhost:5002');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Test Script global - Validação de RFC 7807 em caso de erro 4xx/5xx",
          "if (pm.response.code >= 400) {",
          "    pm.test('Resposta de erro em conformidade com RFC 7807 (ProblemDetails)', function () {",
          "        var jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('title');",
          "        pm.expect(jsonData).to.have.property('status');",
          "        pm.expect(jsonData).to.have.property('detail');",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl_gateway",
      "value": "http://localhost:5050",
      "type": "string"
    },
    {
      "key": "baseUrl_pluggy",
      "value": "http://localhost:5056",
      "type": "string"
    },
    {
      "key": "baseUrl_aggregator",
      "value": "http://localhost:5002",
      "type": "string"
    },
    {
      "key": "pluggyAccessToken",
      "value": "",
      "type": "string"
    },
