  "item": [
    {
      "name": "1. ApiGateway (BFF)",
      "item": [
        {
          "name": "Autenticação - Gerar Dev JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Retornou token de acesso válido', function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(jsonData.tokenType).to.eql('Bearer');",
                  "});",
                  "",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('bearerToken', jsonData.accessToken);",
                  "    console.log('✅ Bearer Token capturado automaticamente para a coleção:', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{devUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl_gateway}}/api/v1/gateway/auth/dev-token",
              "host": ["{{baseUrl_gateway}}"],
              "path": ["api", "v1", "gateway", "auth", "dev-token"]
            },
            "description": "Gera um token JWT com claim sub=usr_dev_001 válido por 24 horas e salva automaticamente na variável {{bearerToken}} para uso em todas as requisições."
          },
          "response": []
        },
        {
          "name": "Dashboard Consolidado",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('bearerToken')) {",
