{
  "info": {
    "_postman_id": "a9103c8f-2f88-4a57-b129-37e4c27f6e01",
    "name": "FinanceHub Enterprise API Suite",
    "description": "Coleção oficial completa de testes para todos os microsserviços, BFF ApiGateway, Open Finance Meu.Pluggy e TransactionAggregator (.NET 10).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl_gateway",
      "value": "http://localhost:5050",
      "type": "string"
    },
    {
      "key": "baseUrl_pluggy",
      "value": "http://localhost:5056",
      "type": "string"
    },
    {
      "key": "baseUrl_aggregator",
      "value": "http://localhost:5002",
      "type": "string"
    },
    {
      "key": "bearerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "devUserId",
      "value": "usr_dev_001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. ApiGateway (BFF)",
      "item": [
        {
          "name": "Autenticação - Gerar Dev JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('bearerToken', jsonData.accessToken);",
                  "    console.log('Bearer Token capturado automaticamente:', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{devUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl_gateway}}/api/v1/gateway/auth/dev-token",
              "host": ["{{baseUrl_gateway}}"],
              "path": ["api", "v1", "gateway", "auth", "dev-token"]
            },
            "description": "Gera um token JWT com claim sub=usr_dev_001 válido por 24 horas e salva automaticamente na variável {{bearerToken}}."
          },
          "response": []
        },
        {
          "name": "Dashboard Consolidado",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl_gateway}}/api/v1/gateway/dashboard",
              "host": ["{{baseUrl_gateway}}"],
              "path": ["api", "v1", "gateway", "dashboard"]
            },
            "description": "Obtém visão geral de saldos consolidados e resumo por instituição para o usuário autenticado."
          },
          "response": []
        },
        {
          "name": "Saldos Consolidados por Conta",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl_gateway}}/api/v1/gateway/balances/consolidated",
              "host": ["{{baseUrl_gateway}}"],
              "path": ["api", "v1", "gateway", "balances", "consolidated"]
            },
            "description": "Obtém detalhamento de saldo consolidado multi-bancos."
          },
          "response": []
        },
        {
          "name": "Extrato de Transações Paginado",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl_gateway}}/api/v1/gateway/transactions?page=1&pageSize=20",
              "host": ["{{baseUrl_gateway}}"],
              "path": ["api", "v1", "gateway", "transactions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            },
            "description": "Lista histórico de transações deduplicadas do usuário com paginação."
          },
          "response": []
        },
        {
          "name": "Categorizar Transação",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"createCustomRule\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl_gateway}}/api/v1/gateway/transactions/a1b2c3d4-e5f6-7890-abcd-ef1234567890/category",
              "host": ["{{baseUrl_gateway}}"],
              "path": ["api", "v1", "gateway", "transactions", "a1b2c3d4-e5f6-7890-abcd-ef1234567890", "category"]
            },
            "description": "Atualiza a categoria de uma transação específica e opcionalmente cria regra customizada de categorização."
          },
          "response": []
        },
        {
          "name": "Disparar Sync Open Finance via Gateway",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl_gateway}}/api/v1/gateway/pluggy/sync?userId={{devUserId}}",
              "host": ["{{baseUrl_gateway}}"],
              "path": ["api", "v1", "gateway", "pluggy", "sync"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{devUserId}}"
                }
              ]
            },
            "description": "Dispara sincronização de todas as contas Meu.Pluggy do usuário a partir do BFF Gateway."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. PluggyIntegration Service",
      "item": [
        {
          "name": "Disparar Sincronização Direta Meu.Pluggy",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl_pluggy}}/api/v1/pluggy/sync?userId={{devUserId}}",
              "host": ["{{baseUrl_pluggy}}"],
              "path": ["api", "v1", "pluggy", "sync"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{devUserId}}"
                }
              ]
            },
            "description": "Executa diretamente no microsserviço PluggyIntegration o ciclo de ingestão de contas e extratos."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. TransactionAggregator Service",
      "item": [
        {
          "name": "Ingestar Nova Transação (Ledger Ingest)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{devUserId}}\",\n  \"externalId\": \"tx_itau_998877\",\n  \"institutionId\": \"itau\",\n  \"accountNumber\": \"12345-6\",\n  \"description\": \"iFood - Almoço de Trabalho\",\n  \"amount\": 89.90,\n  \"type\": \"Expense\",\n  \"transactionDateUtc\": \"2026-08-17T12:30:00Z\",\n  \"rawCategory\": \"Alimentação\"\n}"
            },
            "url": {
              "raw": "{{baseUrl_aggregator}}/api/v1/transactions/ingest",
              "host": ["{{baseUrl_aggregator}}"],
              "path": ["api", "v1", "transactions", "ingest"]
            },
            "description": "Ingesta um evento de transação no ledger canônico. Executa cálculo de hash SHA-256 e deduplicação."
          },
          "response": []
        },
        {
          "name": "Obter Transações Ingestadas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl_aggregator}}/api/v1/transactions?userId={{devUserId}}&page=1&pageSize=20",
              "host": ["{{baseUrl_aggregator}}"],
              "path": ["api", "v1", "transactions"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{devUserId}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            },
            "description": "Consulta o histórico de transações persistidas no banco PostgreSQL do TransactionAggregator."
          },
          "response": []
        },
        {
          "name": "Obter Saldos Consolidados por Usuário",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl_aggregator}}/api/v1/transactions/balances/user/{{devUserId}}",
              "host": ["{{baseUrl_aggregator}}"],
              "path": ["api", "v1", "transactions", "balances", "user", "{{devUserId}}"]
            },
            "description": "Retorna saldo acumulado total e por conta bancária para o usuário informado."
          },
          "response": []
        },
        {
          "name": "Categorizar Transação Direta",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{devUserId}}\",\n  \"newCategoryId\": \"b2c3d4e5-f6a7-8901-bcde-f23456789012\",\n  \"createCustomRule\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl_aggregator}}/api/v1/transactions/a1b2c3d4-e5f6-7890-abcd-ef1234567890/categorize",
              "host": ["{{baseUrl_aggregator}}"],
              "path": ["api", "v1", "transactions", "a1b2c3d4-e5f6-7890-abcd-ef1234567890", "categorize"]
            },
            "description": "Altera a categoria de uma transação diretamente no microsserviço TransactionAggregator."
          },
          "response": []
        }
      ]
    }
  ]
}
