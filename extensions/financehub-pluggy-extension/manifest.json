{
  "manifest_version": 3,
  "name": "FinanceHub — Pluggy Token Sync",
  "version": "1.0.0",
  "description": "Captura e sincroniza automaticamente o accessToken do meu.pluggy.ai com o FinanceHub.",
  "permissions": [
    "storage",
    "webRequest",
    "cookies",
    "sidePanel",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://meu.pluggy.ai/*",
    "https://my-api.pluggy.ai/*",
    "http://localhost:3000/*",
    "http://localhost:5056/*",
    "http://localhost:5000/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meu.pluggy.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FinanceHub Pluggy Sync"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
